# Copy to .env (Bun loads it automatically) and fill in what you need. Everything is optional.

# Where the server listens. Keep 127.0.0.1 behind a reverse proxy; use 0.0.0.0 to open it to your network.
HOST=127.0.0.1
PORT=8823
# Serve under a sub-path, e.g. https://example.com/taskboard/
# TASKBOARD_BASE_PATH=/taskboard

# Who is on the board.
TASKBOARD_OWNER=maya            # login of the owner (creates and deletes cards, sets the timer)
TASKBOARD_OWNER_NAME=Maya
TASKBOARD_TEAM=theo:Theo,jun:Jun,priya:Priya

# Sign-in.
#   open   = built-in page: pick your name, enter the passcode (required when HOST is not 127.0.0.1)
#   header = trust X-Auth-Request-User from a reverse proxy (oauth2-proxy, Caddy forward_auth, Pomerium, ...)
TASKBOARD_AUTH=open
TASKBOARD_PASSCODE=change-me

# Bearer token that acts as the owner, for scripts like bin/card. Either the token itself or a file holding it.
# TASKBOARD_OWNER_TOKEN=
# TASKBOARD_OWNER_TOKEN_FILE=~/.config/taskboard/owner-token

# Data folder (SQLite database + images).
# TASKBOARD_DATA=data

# Card agents run in Aside (https://aside.com). Path to its CLI, and an optional command prefix when the server runs
# as a background service and has to reach Aside inside a desktop session.
# ASIDE_BIN=~/.local/bin/aside
# ASIDE_WRAP=sudo launchctl asuser 501 sudo -u alice

# Models in the agent menu: a JSON file, or a command printing JSON (re-run every minute). See docs/configuration.md.
# TASKBOARD_MODELS_FILE=./models.json
# TASKBOARD_MODELS_CMD=./bin/my-models
# TASKBOARD_DEFAULT_MODEL=claude-code/claude-opus-5-5

# Board agent (team chat) and screenshot reader run on the Claude Code CLI.
# CLAUDE_BIN=claude
# BOARD_MODEL=claude-haiku-5-5
# READER_MODEL=claude-sonnet-5-5
